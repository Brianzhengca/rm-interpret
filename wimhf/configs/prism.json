{
  "dataset": {
    "name": "PRISM",
    "path": "https://huggingface.co/datasets/rmovva/wimhf-data/resolve/main/data/prism.json",
    "split_columns": [
      "conversation_id"
    ],
    "train_split_size": 0.8,
    "split_random_seed": 42,
    "random_seed": 42,
    "max_words_prompt": 256,
    "max_words_response": 256
  },
  "embedding": {
    "model": "Qwen/Qwen3-Embedding-8B",
    "n_workers": 2,
    "provider": "local",
    "batch_size": 1,
    "text_mode": "instructed_prompt_response"
  },
  "sae": {
    "M": 32,
    "K": 4,
    "prefix_lengths": [
      8,
      32
    ],
    "batch_size": 256,
    "n_epochs": 50,
    "min_epochs": 10,
    "patience": 3,
    "learning_rate": 0.0005,
    "dead_neuron_threshold_steps": 64
  },
  "interpretation": {
    "interpreter_model": "Qwen/Qwen3-32B",
    "annotator_model": "Qwen/Qwen3-32B",
    "abbreviator_model": "Qwen/Qwen3-32B",
    "n_candidates": 5,
    "interpret_n_examples": 10,
    "interpret_sampling_kwargs": {
      "percentile_bin": [
        95,
        100
      ],
      "nonzero_only": true,
      "swap_negative_response_pairs": true
    },
    "scoring_n_examples": 300,
    "scoring_sampling_kwargs": {
      "high_percentile": [
        50,
        100
      ],
      "low_percentile": [
        0,
        50
      ],
      "nonzero_only": true
    },
    "min_correlation": 0.0,
    "p_value_threshold": 0.0015625,
    "n_workers_interpretation": 1,
    "n_workers_annotation": 1,
    "timeout": 120.0,
    "max_interpretation_tokens": 2048,
    "completion_kwargs": {},
    "interpret_completion_kwargs": {
      "max_tokens": 2048,
      "batch_size": 16,
      "tokenizer_kwargs": {
        "enable_thinking": false
      },
      "llm_sampling_kwargs": {
        "temperature": 0.6,
        "top_p": 0.95,
        "top_k": 20
      },
      "llm_engine_kwargs": {
        "gpu_memory_utilization": 0.7,
        "max_model_len": 16384,
        "max_num_seqs": 16,
        "disable_custom_all_reduce": true
      }
    },
    "annotation_completion_kwargs": {
      "max_tokens": 8,
      "batch_size": 64,
      "tokenizer_kwargs": {
        "enable_thinking": false
      },
      "llm_sampling_kwargs": {
        "temperature": 0.0
      },
      "llm_engine_kwargs": {
        "gpu_memory_utilization": 0.7,
        "max_model_len": 16384,
        "max_num_seqs": 16,
        "disable_custom_all_reduce": true
      }
    },
    "abbreviation_completion_kwargs": {
      "max_tokens": 64,
      "tokenizer_kwargs": {
        "enable_thinking": false
      },
      "llm_sampling_kwargs": {
        "temperature": 0.0
      },
      "llm_engine_kwargs": {
        "gpu_memory_utilization": 0.7,
        "max_model_len": 16384,
        "max_num_seqs": 16,
        "disable_custom_all_reduce": true
      }
    }
  },
  "selection": {
    "controls": [
      "length_delta"
    ],
    "lasso_top_k": [
      5,
      10
    ],
    "max_samples_lasso": null,
    "classification": true,
    "standardize": true
  },
  "runtime": {
    "checkpoint_dir": "outputs/prism/checkpoints",
    "cache_dir": "outputs/prism/emb_cache",
    "retrain_sae": false
  }
}
